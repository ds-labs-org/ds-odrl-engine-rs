# Generated by Cargo (Trunk's own `cargo build` output, plus node_packages
# downloads under target/node_modules/) -- not covered by the workspace
# root .gitignore's `/target`, which is anchored at the repo root.
/target/

# Generated by Trunk
/dist
/dist.trunk-lock

# Generated by npm/node_packages resolution
/node_modules/
package-lock.json

# The compiled engine.wasm artifact, rebuilt from the `engine` crate by
# Trunk.toml's own pre_build hook on every build -- not source, not
# checked in (mirrors how ../target/ itself is ignored).
/assets/engine.wasm

# Backup files generated by rustfmt
**/*.rs.bk
